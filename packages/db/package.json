{
  "name": "@toksync/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@toksync/privacy": "workspace:*",
    "@toksync/shared": "workspace:*",
    "drizzle-orm": "^0.43.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
